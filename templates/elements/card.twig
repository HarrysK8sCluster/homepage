<article class="card {% if Image %}card-image{% endif %}">
    {% if Image %}
        <img src="{{ Image }}" alt="{{ Heading }}" />
    {% endif %}
    <div>
        <h2>{{ Heading }}</h2>

        %content%
    </div>
    {% if Footer %}
        <footer>
            {{ Footer }}
        </footer>
    {% endif %}
</article>