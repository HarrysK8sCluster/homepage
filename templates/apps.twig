{% extends "layouts/base.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ manifest['home.css'] ?? '/assets/home.css' }}">
{% endblock %}

{% block content %}

    <header class="entry">
        <img src="media/home/apps.webp" alt="Apps" />
        <div>
            <h1>
                <small class="main">Apps</small>
                <small class="outro">Web // Automatisierung // Clean Code</small>
            </h1>
            <p>
                Hier findest du meine eigenen, produktiven Projekte: pragmatische Web-Entwicklung mit Fokus auf sauberem
                Code, reproduzierbaren Deployments und möglichst wenig Handarbeit.
            </p>
        </div>
    </header>

    <div class="teaser">
        <h2>Eigene Projekte – klein, nützlich, produktiv</h2>
        <p>
            Ich baue Dinge, die ich selbst täglich nutze. Meist klassisch im LAMP-Stack (Linux, Apache, MySQL, PHP),
            kombiniert mit Twig und Webpack. Wenn es um Betrieb und Ausrollen geht, denke ich gern in Richtung Nginx,
            Container und Kubernetes – die Details dazu liegen auf der Ops-Seite.
        </p>
    </div>

    <div class="row">
        <article class="card">
            <div>
                <h2>Diese Website</h2>
                <p>
                    Meine persönliche Webpräsenz: eine kleine, performante Seite als Home für Inhalte rund um Homelab,
                    Automatisierung und Projekte.
                </p>
                <ul>
                    <li>schlanke Templates mit Twig, klare Struktur statt Over-Engineering</li>
                    <li>Asset-Build mit Webpack, saubere Trennung von Layout und Inhalt</li>
                    <li>Fokus auf Lesbarkeit, Wartbarkeit und schnelle Iteration</li>
                </ul>
            </div>
        </article>

        <article class="card">
            <div>
                <h2>Home Assistant – Pyscript Automationen</h2>
                <p>
                    Python-basierte Automationen in Home Assistant – nicht als „Spielerei“, sondern als produktive
                    Logik, die zuverlässig im Alltag läuft.
                </p>
                <ul>
                    <li>Automatisierungen als Code: versionierbar, nachvollziehbar, erweiterbar</li>
                    <li>Fokus auf robuste Logik statt Clicki-Bunti-Regeln</li>
                    <li>weniger manuelle Schritte: Events, Trigger und Zustände sauber zusammengeführt</li>
                </ul>
                <p>
                    Hinweis: Das ist intern im Homelab und nicht öffentlich als Demo verfügbar.
                </p>
            </div>
        </article>
    </div>

    <div class="row">
        <article class="card">
            <div>
                <h2>Stack & Tools</h2>
                <ul class="tagcloud">
                    <li>Linux</li>
                    <li>Apache</li>
                    <li>MySQL</li>
                    <li>PHP</li>
                    <li>Twig</li>
                    <li>Webpack</li>
                    <li>PHP-DI</li>
                    <li>Nginx</li>
                    <li>Kubernetes</li>
                </ul>
                <p>
                    Frameworks: Ich habe lange und gern mit Zend gearbeitet – heute halte ich es oft bewusst schlank und
                    setze lieber auf klare Architektur, saubere Libraries und Automatisierung.
                </p>
            </div>
        </article>

        <article class="card">
            <div>
                <h2>Worauf ich Wert lege</h2>
                <ul>
                    <li>Clean Code: Lesbarkeit, klare Verantwortlichkeiten, weniger Magie</li>
                    <li>Automatisierung: Builds und Deployments reproduzierbar statt „läuft auf meinem Rechner“</li>
                    <li>Pragmatismus: sinnvoller Tech-Stack, nicht der nächste Hype</li>
                </ul>
            </div>
            <footer>
                <a class="btn btn--primary btn--sm" href="/devops">
                    Mehr zu Ops/CI/CD →
                </a>
            </footer>
        </article>
    </div>

{% endblock %}
