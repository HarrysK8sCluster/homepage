{% extends "layouts/base.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ manifest['home.css'] ?? '/assets/home.css' }}">
{% endblock %}

{% block content %}


    <header class="entry">
        <img src="media/home/hiiam.png" alt="Über mich" />
        <div>
            <h1>
                <small class="intro">Hallo, ich bin</small>
                <small class="main">Philipp Kremer</small>
                <small class="outro">Entwickler // Nerd // Automatisierungs-Fan</small>
            </h1>
            <p>
                Ich baue Web-Anwendungen (klassisch mit LAMP, aber auch modern gedacht) und betreibe meine eigene kleine
                Plattform zu Hause – inklusive Kubernetes, GitOps und Selfhosting.
            </p>
        </div>
    </header>

    <div class="teaser">
        <h2>Über mich - kurz & ehrlich</h2>
        <p>
            Ich bin Philipp - Fullstack/Platform-Tüftler. Ich liebe es, wenn Code sauber ist.
            Deployments reproduzierbar sind und Automatisierung nervige Handarbeit ersetzt.
        </p>
    </div>

    <div class="row">
        <article class="card">
            <div>
                <h2>Warum ich das mache</h2>
                <p>
                    Neugier, Lernen und Spaß am Optimieren. Mein Homelab ist meine Spielwiese - hier teste ich
                    Tools, baue Plattformen und mache Dinge so automatisch wie möglich.
                </p>
            </div>
        </article>
        <article class="card">
            <div>
                <h2>Was du hier findest</h2>
                <ul>
                    <li>eigene Entwicklungen</li>
                    <li>GitOps Deployments mit Flux</li>
                    <li>Kubernetes Setup & Learnings</li>
                    <li>Selfhosting & Tools</li>
                </ul>
            </div>
        </article>
    </div>
    <div class="row">
        <article class="card">
            <div>
                <h2>Schwerpunkte</h2>
                <ul class="tagcloud">
                    <li>Softwarearchitektur</li>
                    <li>LAMP / PHP Backend</li>
                    <li>Kubernetes</li>
                    <li>GitOps (Flux)</li>
                    <li>Automatisierung</li>
                    <li>Selfhosting</li>
                    <li>Netzwerke</li>
                    <li>Clean Code</li>
                    <li>Netzwerk & VLANs</li>
                    <li>Identity & Access (OIDC)</li>
                    <li>Secrets Management</li>
                    <li>Release / Deployment Automation</li>
                    <li>API Design</li>
                    <li>Observability Basics (Logs/Metrics)</li>
                    <li>Fullstack Webentwicklung</li>
                    <li>Bastelprojekte</li>
                </ul>
            </div>
        </article>
    </div>

    <div class="row">
        <article class="card">
            <div>
                <h2>Nerd-Facts</h2>
                <ul>
                    <li>Ich mag cleanes Automation-Setup</li>
                    <li>Ich vertraue nichts, was nicht in Git liegt.</li>
                    <li>Deployment nicht reproduzierbar? Oh no!</li>
                    <li>Ich benenne Dinge gerne ordentlich</li>
                    <li>Kabelmanagement? Dafür gibt's KI-Bilder 😄</li>
                </ul>
            </div>
        </article>
        <article class="card">
            <div>
                <h2>Kontakt</h2>
                <ul class="nopoint">
                    <li>E-Mail: <span class="mail"></span></li>
                    <li>GitHub: <a target="_blank" href="https://github.com/phiKremer">phiKremer</a></li>
                    <li>Xing: <a target="_blank" href="https://www.xing.com/profile/Philipp_Kremer4">Philipp_Kremer4</a></li>
                    <li>LinkedIn: <a target="_blank" href="https://www.linkedin.com/in/philipp-kremer-67a5b3385/">philipp-kremer-67a5b3385</a> </li>
                </ul>
            </div>
        </article>
    </div>


    <script>
        const user = "web.delphin";
        const domain = "googlemail.com";
        const mails = document.getElementsByClassName("mail");
        for (let i = 0; i < mails.length; i++) {
            mails[i].innerHTML = `<a href="mailto:${user}@${domain}">${user}@${domain}</a>`;
        }
    </script>
{% endblock %}
