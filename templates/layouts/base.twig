<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Homelab{% endblock %}</title>

    {% set manifest = manifest is defined ? manifest : {} %}

    <link rel="stylesheet" href="{{ _manifest['layout.css'] }}">
    {% block stylesheets %}{% endblock %}

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
</head>
<body>

<header class="site-header">
    <div>
        <a class="logo" href="/">
            <img src="/logo.svg" alt="Logo" />
            <span class="akzent">pk</span>remer
        </a>

        <button class="nav-toggle"
                type="button"
                aria-label="Menü öffnen"
                aria-controls="main-nav"
                aria-expanded="false">
            ☰
        </button>
        <nav class="main-nav" aria-label="Hauptnavigation">
            <a href="/">Home</a>
            <a href="/about">Über mich</a>
            <a href="/homelab">Homelab</a>
            <a href="/apps">Apps</a>
            <a href="/devops">DevOps</a>

            <hr class="metanav nav-sep" />

            <a class="metanav" href="/imprint">Impressum</a>
            <a class="metanav" href="/privacy">Datenschutz</a>
        </nav>
    </div>
</header>

<main class="content">
    {% block content %}{% endblock %}

</main>

<footer class="site-footer">
    <div>
        <nav aria-label="Meta Navigation">
            <a href="/imprint">Impressum</a>
            <a href="/privacy">Datenschutz</a>
        </nav>

        <small class="copyright">
            © <span id="year"></span> Philipp Kremer
            <script>
                document.getElementById("year").textContent = new Date().getFullYear();
            </script>
        </small>
    </div>
</footer>
<script>
    const header = document.querySelector(".site-header");
    const btn = document.querySelector(".nav-toggle");
    const nav = document.getElementById("main-nav");
    function setOpen(open) {
        header.dataset.navOpen = open ? "true" : "false";
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        btn.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
    }
    btn.addEventListener("click", () => {
        setOpen(header.dataset.navOpen !== "true");
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
    });
    nav.addEventListener("click", (e) => {
        if (e.target.tagName === "A") setOpen(false);
    });
    setOpen(false);
</script>
</body>
</html>
