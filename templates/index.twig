{% extends "layouts/base.twig" %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ manifest['home.css'] ?? '/assets/home.css' }}">
{% endblock %}
{% block content %}



    <header class="entry">
        <img src="media/home/hiiam.png" alt="Über mich" />
        <div>
            <h1>
                <small class="intro">Hallo, ich bin</small>
                <small class="main">Philipp Kremer</small>
                <small class="outro">DevOps-Enthusiast // Tech-Tüftler</small>
            </h1>
            <p>
                Ich schreibe über Homelab-Projekte, Automatisierung und nützliche Apps. Von Infrastruktur bis Self-Hosting
                hier gibt's alles rund um spannende Tech-Themen.
            </p>
            <p>
                Schau dich gern um!
            </p>
            <a class="btn" href="/about">
                Lerne mich kennen →
            </a>

        </div>
    </header>

    <div class="row">


        <article class="card">
            <img src="/media/home/homelab.png" alt="Homelab" />

            <div>
                <h2>Mein Homelab</h2>
                <p>
                    Einblick in mein Homelab, Hardware-Setups und Netzwerkprojekte.
                </p>
            </div>

            <footer>
                <a class="btn btn--primary btn--sm" href="/homelab">
                    Zu meinem Homelab →
                </a>
            </footer>
        </article>

        <article class="card">
            <img src="/media/home/apps.png" alt="Apps" />

            <div>
                <h2>Meine Apps</h2>
                <p>
                    Meine eigenen Web-Projekte – von klassischen LAMP-Stacks bis zu kleinen Tools,
                    APIs und Automatisierungen.
                </p>
            </div>

            <footer>
                <a class="btn btn--primary btn--sm" href="/devops">
                    Zu Ops/CI/CD →
                </a>
            </footer>
        </article>

        <article class="card">
            <img src="/media/home/ops.png" alt="Apps" />

            <div>
                <h2>DevOps</h2>
                <p>
                    Alles rund um GitOps & Kubernetes: Deployments, CI/CD, Automatisierung und Betrieb moderner Services.
                </p>
            </div>

            <footer>
                <a class="btn btn--primary btn--sm" href="/apps">
                    Zu meinen Projekten →
                </a>
            </footer>
        </article>

    </div>



{% endblock %}
