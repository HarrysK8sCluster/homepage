{
  "name": "php-webpack-assets",
  "private": true,
  "version": "1.0.0",
  "description": "Webpack asset pipeline for PHP/Twig project",
  "scripts": {
    "dev": "webpack --config webpack/webpack.dev.js",
    "watch": "WATCHPACK_POLLING=true webpack --watch --config webpack/webpack.dev.js",
    "build": "webpack --config webpack/webpack.prod.js"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.5",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-manifest-plugin": "^5.0.0",
    "webpack-merge": "^6.0.1"
  }
}
